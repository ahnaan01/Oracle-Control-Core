{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "runtime": {
      "type": "string",
      "enum": [
        "docker",
        "compose",
        "systemd",
        "node",
        "external"
      ]
    },
    "capabilities": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
      }
    },
    "healthEndpoint": {
      "type": "string",
      "format": "uri"
    },
    "operations": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "status",
              "health"
            ]
          },
          "readOnly": {
            "type": "boolean",
            "const": true
          },
          "permission": {
            "type": "string",
            "const": "project:read"
          }
        },
        "required": [
          "name",
          "description",
          "kind",
          "readOnly",
          "permission"
        ],
        "additionalProperties": false
      }
    },
    "eventsPublished": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
      }
    },
    "eventsConsumed": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
      }
    },
    "requiredPermissions": {
      "default": [],
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "project:read",
          "health:write",
          "events:write",
          "events:read",
          "operations:invoke"
        ]
      }
    },
    "configuration": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "id",
    "name",
    "description",
    "version",
    "runtime",
    "capabilities",
    "operations",
    "eventsPublished",
    "eventsConsumed",
    "requiredPermissions",
    "configuration"
  ],
  "additionalProperties": false
}
