# No external credentials required. Copy to .env for local development.
OCC_MODE=mock
OCC_HOST=127.0.0.1
OCC_PORT=3000
OCC_BASE_PATH=/sys
OCC_PUBLIC_ORIGIN=http://localhost:3000
OCC_DB_PATH=./data/occ.sqlite
OCC_SECURE_COOKIES=false
OCC_TRUST_PROXY=false
OCC_RETENTION_DAYS=30
OCC_DOCKER_MODE=disabled
# Optional collector settings (disabled without explicit private credentials):
OCC_HOST_MONITOR_MODE=disabled
OCC_TELEGRAM_ENABLED=false
OCC_WHATSAPP_ENABLED=false
# OCC_HOST_MONITOR_URL=http://host-monitor:2376
# OCC_HOST_MONITOR_TOKEN_FILE=./data/operator/host-monitor
# OCC_DOCKER_MONITOR_TOKEN_FILE=./data/operator/docker-monitor
# Optional, only for a separately secured read-only HTTP monitoring proxy:
# OCC_DOCKER_PROXY_URL=http://docker-monitor:2375
# OCC_IDENTITY_FILE=./config/identities.json
# Do not set credentials until explicitly enabling a live transport.
# Use different random secrets for each transport (at least 32 characters each).
# OCC_TELEGRAM_GATEWAY_TOKEN=<telegram transport credential>
# OCC_WHATSAPP_GATEWAY_TOKEN=<whatsapp transport credential>
# All transport/collector credentials also support NAME_FILE=private-file-path.
# Prefer npm run setup for Docker: it creates distinct files with mode 0600.
# OCC_TELEGRAM_TOKEN=<separate OCC bot token; never TelegramDL's token>
# OCC_TELEGRAM_USERNAME=occ_controller_bot
# OCC_WHATSAPP_SESSION_DIR=./sessions/whatsapp
# OCC_CORE_URL=http://127.0.0.1:3000/sys/api/v1
